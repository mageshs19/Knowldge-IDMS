+def write_inventory(rows: Iterable[InventoryRow], path: Path | None = None) -> tuple[Path, int]:
+    """Upsert members into one workbook using an exclusive lock + atomic replace.
+
+    Existing unselected members and their comments remain. A corrupt/locked file
+    is an explicit error, not silently overwritten. A failed save retains the
+    previous workbook. Network fetching itself must use one writer per workspace.
+    """
+    path = Path(path) if path is not None else workspace_root() / "Review" / FETCH_INVENTORY_FILENAME
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if path.is_symlink():
+        raise ValueError("Refusing an inventory symlink")
+    lock = path.with_suffix(path.suffix + ".lock")
+    try:
+        descriptor = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+    except FileExistsError as exc:
+        raise RuntimeError(f"Inventory is being written: {lock}. Do not run parallel fetches.") from exc
+    temporary: Path | None = None
+    try:
+        os.close(descriptor)
+        records = _existing_rows(path)
+        incoming: set[str] = set()
+        for row in rows:
+            key = row.program.strip().upper()
+            if not key or key in incoming:
