+def read_rows(path):
+    book = load_workbook(path)
+    try:
+        return {r[0].value: [c.value for c in r] for r in book.active.iter_rows(min_row=5, max_col=5)
+                if r[0].value}
+    finally:
+        book.close()
+
+
+@pytest.fixture
