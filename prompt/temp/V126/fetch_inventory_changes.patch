+    registry.update({
+        ("PROGRAM", "APP0001"): "COPY CP1.\nDB SUB1 WITHIN SCHEMA1.\nOBTAIN NEXT LOGREC.\nREADY USAGE-MODE IS RETRIEVAL.",
